# Copy to .env to override defaults.
#   cp .env.example .env

# Host port mapped to the container's :8000. Default 8000.
# Useful if your host already has something on 8000.
# HOST_PORT=8080

# --- Natural-language incident agent (opt-in) ---
# Set an LLM key to enable the "Ask the incident history" panel on the
# Incidents dashboard. Leave unset and the panel shows a calm "disabled"
# note — everything else works offline. BYO-LLM; costs your own tokens.
# Works with Anthropic OR OpenAI — the key prefix is auto-detected
# (sk-ant-... = Anthropic, sk-... = OpenAI). Just paste your key:
# MD_LLM_API_KEY=sk-ant-...      # or sk-...  for OpenAI
# MD_LLM_MODEL=                  # optional; defaults per provider
# Force a provider / use a local OpenAI-compatible model (air-gap):
# MD_LLM_PROVIDER=openai
# MD_LLM_BASE_URL=http://your-local-llm:8080/v1

# --- Native alerting (opt-in, Fleet) ---
# POST an incident notification to your Slack / PagerDuty / webhook on every
# capture. Metadata only (no recordings/PII); your destinations, your network.
# Get a Slack URL at https://api.slack.com/apps -> Incoming Webhooks.
# MD_ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/T.../B.../xxx
# MD_ALERT_PAGERDUTY_ROUTING_KEY=R0...     # PagerDuty Events API v2
# MD_ALERT_WEBHOOK_URL=https://example.com/hook
# MD_ALERT_COOLDOWN_S=300                   # per (rule, robot); default 300
# Make the "View in MissionDebug" deep-link clickable from Slack: set this to
# the hub URL your browser reaches (your VM's IP, not localhost, if remote).
# MD_HUB_PUBLIC_URL=http://192.168.1.50:8000

# --- Age-based lifecycle (opt-in, Fleet) ---
# cold = release recording bytes after N days but KEEP the incident record;
# delete = purge the whole session after N days. Unset/0 = off.
# MD_COLD_AFTER_DAYS=30
# MD_DELETE_AFTER_DAYS=90
