# Copy to .env to override defaults.
#   cp .env.example .env

# Host port mapped to the container's :8000. Default 8000.
# Useful if your host already has something on 8000.
# HOST_PORT=8080

# --- Natural-language incident agent (opt-in) ---
# Set an LLM key to enable the "Ask the incident history" panel on the
# Incidents dashboard. Leave unset and the panel shows a calm "disabled"
# note — everything else works offline. BYO-LLM; costs your own tokens.
# MD_LLM_API_KEY=sk-ant-...
# MD_LLM_MODEL=claude-sonnet-4-6
# Air-gapped? point at a local / proxied model instead of the cloud:
# MD_LLM_BASE_URL=http://your-local-llm:8080
